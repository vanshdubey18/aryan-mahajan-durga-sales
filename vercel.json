{
  "cleanUrls": true,
  "redirects": [
    { "source": "/about", "destination": "/#story", "permanent": true },
    { "source": "/products", "destination": "/#pulses", "permanent": true },
    { "source": "/quality", "destination": "/#freshness", "permanent": true },
    { "source": "/gallery", "destination": "/#pulses", "permanent": true },
    { "source": "/contact", "destination": "/#visit", "permanent": true }
  ],
  "headers": [
    {
      "source": "/assets/fonts/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/assets/img/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }]
    }
  ]
}
